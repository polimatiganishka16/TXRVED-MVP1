generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        Int                @id @default(autoincrement())
  name                      String?
  email                     String             @unique
  password                  String
  role                      Role               @default(CANDIDATE)
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime@updatedAt
  isVerified                Boolean            @default(false)
  verificationToken         String?
  verificationTokenExpiry   DateTime?
  resetToken                String?
  resetTokenExpiry          DateTime?
  candidate                 Candidate?
  evaluationResults         EvaluationResult[]
  examAttempts              ExamAttempt[]
  notifications             Notification[]
}

model Submission {
  id          Int          @id @default(autoincrement())
  scenarioId  Int
  submittedAt String
  candidateId Int?
  attemptId   Int?
  answers     Answer[]
  questionScores QuestionScore[]
  attempt     ExamAttempt? @relation(fields: [attemptId], references: [id])
  candidate   Candidate?   @relation(fields: [candidateId], references: [id])
}

model Answer {
  id           Int        @id @default(autoincrement())
  submissionId Int
  questionId   Int
  answer       String
  submission   Submission @relation(fields: [submissionId], references: [id])
}

model ExamAttempt {
  id               Int          @id @default(autoincrement())
  start_time       DateTime     @default(now())
  submit_time      DateTime?
  duration_minutes Float?
  status           String       @default("started")
  userId           Int?
  candidateId      Int?
  candidate        Candidate?   @relation(fields: [candidateId], references: [id])
  user             User?        @relation(fields: [userId], references: [id])
  submissions      Submission[]
  questionScores   QuestionScore[]
}

model EvaluationResult {
  id                 Int      @id @default(autoincrement())
  submissionId       Int
  scenarioId         Int
  overallScore       Float
  understanding      Float
  awareness          Float
  decision           Float
  clarity            Float
  feedback           Json
  evaluatedQuestions Json
  createdAt          DateTime @default(now())
  evaluatorId        Int?
  evaluator          User?    @relation(fields: [evaluatorId], references: [id])
}

model Candidate { 
  id             Int           @id @default(autoincrement())
  candidate_code String        @unique
  name           String
  userId         Int?          @unique
  user           User?         @relation(fields: [userId], references: [id])
  attempts       ExamAttempt[]
  submissions    Submission[]
}

enum Role {
  ADMIN
  EVALUATOR
  CANDIDATE
}
model Scenario {
  id          Int        @id @default(autoincrement())
  title       String
  description String
  category    String

  icon        String?
  level       String?
  levelColor  String?

  questions   Question[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Question {
  id           Int       @id @default(autoincrement())

  scenarioId   Int
  scenario     Scenario  @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  questionText String
  questionType String
  orderNo      Int

  options      Option[]

  createdAt    DateTime  @default(now())
}

model Option {
  id         Int      @id @default(autoincrement())

  questionId Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  optionText String?
  imageUrl   String?

  createdAt  DateTime @default(now())
}

model Notification {
  id        Int     @id @default(autoincrement())
  userId    Int
  title     String
  message   String
  isRead    Boolean @default(false)
  createdAt DateTime @default(now())

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model Evaluation {
 id Int @id @default(autoincrement())
 responseId Int
 understanding Int
 clarity Int
 awareness Int
 decision Int
 actionability Int
 capabilityIndex Float
 confidenceIndex Float
 coverageIndex Float
 createdAt DateTime @default(now())
}
model QuestionScore {
 id Int @id @default(autoincrement())
 submissionId Int
 attemptId Int?
 questionId Int
 score Float
 understandingEvidence Json?
 awarenessEvidence Json?
 decisionEvidence Json?
 actionabilityEvidence Json?
 clarityEvidence Json?
 createdAt DateTime @default(now())
 submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
 attempt ExamAttempt? @relation(fields: [attemptId], references: [id], onDelete: Cascade)

 @@map("question_score")
}
model Evidence {
 id Int @id @default(autoincrement())
 responseId Int
 type String
 keyword String
 sentence String
}
model AIEvidenceAudit {
 id Int @id @default(autoincrement())
 submissionId Int
 audit Json
 createdAt DateTime @default(now())
}
model CapabilityTrait {
 id Int @id @default(autoincrement())
 submissionId Int
 traitName String
 confidence Float
 evidence Json
 createdAt DateTime @default(now())
}
model CapabilityInsight {
 id Int @id @default(autoincrement())
 submissionId Int
 strengths Json
 improvements Json
 recommendations Json
 createdAt DateTime @default(now())
}
model AIInsight {
 id Int @id @default(autoincrement())
 submissionId Int
 strengths Json
 improvements Json
 recommendations Json
 createdAt DateTime @default(now())
}
model EvaluationReport {
  id               Int       @id @default(autoincrement())
  submissionId     Int
  reportData       Json
  status           String    @default("PENDING")
  evaluatorComment String?
  modifiedReport   Json?
  reviewedBy       Int?
  reviewedAt       DateTime?
  createdAt        DateTime  @default(now())
}